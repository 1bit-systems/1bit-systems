#version 450
// dmmv_q1_bonsai.comp — Q1_0_g128 Bonsai 1-bit GEMV, portable Vulkan path
// for the 1bit engine. Mirrors src/bonsai_q1_gemv.hip's block format
// exactly (18 bytes / 128 weights, sign bit LSB-first), using the same
// subgroup-size-agnostic 2-rows/workgroup topology as
// dmmv_tq2_bonsai.comp -- see that file for the portability rationale.
//
// Block layout (18 bytes, 128 weights):
//   [fp16 d : 2 bytes][qs[16] : 16 bytes, 1 sign bit/weight, LSB-first]
//   w[i] = (qs[i/8] >> (i%8)) & 1 ? +d : -d.
//
// Activations are raw fp16 bytes (matching bonsai_q1_gemv_launch's real
// uint16_t* act_fp16 contract), manually unpacked -- same reasoning as
// dmmv_tq2_bonsai.comp: avoid requiring GL_EXT_shader_16bit_storage.

#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint a_offset;
    uint x_offset;
    uint y_offset;
    uint acc_mode;
};

layout(set = 0, binding = 0) readonly buffer MatrixA { uint8_t a_data[]; };
layout(set = 0, binding = 1) readonly buffer VectorX { uint8_t x_data[]; };
layout(set = 0, binding = 2) buffer VectorY { float y_data[]; };

const uint BLOCK_WEIGHTS = 128u;
const uint BLOCK_BYTES = 18u;
const uint QS_OFFSET = 2u;

// Sized for the smallest realistic subgroup width (Intel: 8) at the
// largest workgroup here (64 threads) -> up to 8 subgroups/workgroup.
shared float s_sum0[8];
shared float s_sum1[8];

float fp16ToFloat(uint lo, uint hi) {
    return unpackHalf2x16(lo | (hi << 8u)).x;
}

// bit==1 -> +1, bit==0 -> -1.
float signValue(uint bit) {
    return bit != 0u ? 1.0 : -1.0;
}

void main() {
    uint wg_id = gl_WorkGroupID.x;
    uint row0 = wg_id * 2u;
    uint row1 = row0 + 1u;
    uint tid = gl_LocalInvocationID.x;

    uint blocks_per_row = K / BLOCK_WEIGHTS;

    float sum0 = 0.0;
    float sum1 = 0.0;

    uint row0_base = a_offset + row0 * blocks_per_row * BLOCK_BYTES;
    uint row1_base = a_offset + row1 * blocks_per_row * BLOCK_BYTES;

    for (uint blk = 0u; blk < blocks_per_row; blk++) {
        uint x_base = x_offset + blk * BLOCK_WEIGHTS;
        for (uint hh = 0u; hh < 2u; hh++) {
            uint j = tid + hh * 64u;
            uint byte_idx = QS_OFFSET + (j >> 3u);
            uint bit_off = j & 7u;
            uint xj_off = (x_base + j) * 2u;
            float xj = fp16ToFloat(uint(x_data[xj_off]), uint(x_data[xj_off + 1u]));

            if (row0 < M) {
                uint blk_base = row0_base + blk * BLOCK_BYTES;
                float d = fp16ToFloat(uint(a_data[blk_base]), uint(a_data[blk_base + 1u]));
                uint bit = (uint(a_data[blk_base + byte_idx]) >> bit_off) & 1u;
                sum0 += signValue(bit) * d * xj;
            }
            if (row1 < M) {
                uint blk_base = row1_base + blk * BLOCK_BYTES;
                float d = fp16ToFloat(uint(a_data[blk_base]), uint(a_data[blk_base + 1u]));
                uint bit = (uint(a_data[blk_base + byte_idx]) >> bit_off) & 1u;
                sum1 += signValue(bit) * d * xj;
            }
        }
    }

    sum0 = subgroupAdd(sum0);
    sum1 = subgroupAdd(sum1);
    if (subgroupElect()) {
        uint sg_idx = gl_SubgroupID;
        s_sum0[sg_idx] = sum0;
        s_sum1[sg_idx] = sum1;
    }
    memoryBarrierShared();
    barrier();

    if (tid == 0u) {
        float total0 = 0.0;
        float total1 = 0.0;
        uint n_sg = (gl_WorkGroupSize.x + gl_SubgroupSize - 1u) / gl_SubgroupSize;
        for (uint i = 0u; i < n_sg && i < 8u; i++) {
            total0 += s_sum0[i];
            total1 += s_sum1[i];
        }
        uint y0 = y_offset / 4u + row0;
        uint y1 = y_offset / 4u + row1;
        if (row0 < M) { if (acc_mode == 0u) y_data[y0] = total0; else y_data[y0] += total0; }
        if (row1 < M) { if (acc_mode == 0u) y_data[y1] = total1; else y_data[y1] += total1; }
    }
}
