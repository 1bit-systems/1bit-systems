#!/usr/bin/env bash
# JARVIS — Private AI Assistant. Full TUI with JARVIS theme.
set -e

PI="/home/bcloud/.local/bin/pi"
THEME="/home/bcloud/.pi/agent/themes/jarvis.json"

case "${1:-chat}" in
  chat|"")
    # Full interactive TUI with JARVIS theme (pink primary, green accents)
    exec "$PI" --theme "$THEME" "${@:2}"
    ;;
  start)
    exec /home/bcloud/jarvis/jarvis start
    ;;
  stop)
    exec /home/bcloud/jarvis/jarvis stop
    ;;
  status)
    exec /home/bcloud/jarvis/jarvis status
    ;;
  mobile)
    exec /home/bcloud/jarvis/jarvis mobile "${@:2}"
    ;;
  demo)
    exec bash /home/bcloud/jarvis/scripts/demo.sh
    ;;
  help|--help|-h)
    echo "JARVIS — Private AI Assistant"
    echo ""
    echo "  Usage: jarvis [command]"
    echo ""
    echo "  (no args)    Full TUI interactive session"
    echo "  start        Start JARVIS server"
    echo "  stop         Stop JARVIS server"
    echo "  status       Show backend status"
    echo "  mobile       Expose via ngrok + QR"
    echo "  demo         Run capability demo"
    echo "  help         This help"
    echo ""
    echo "  Visit https://jarvis.1bit.systems"
    ;;
  *)
    exec /home/bcloud/jarvis/jarvis "$@"
    ;;
esac
