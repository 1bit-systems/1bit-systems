#version 460
// RMS Norm: x[i] = x[i] / sqrt(mean(x^2) + eps) * w[i]
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer X { float x[]; };
layout(std430, binding = 2) readonly buffer W { float w[]; };
layout(push_constant) uniform Push { uint M, N, K, s; float sc, eps, th, p; int tok, l, h, pos; } pc;
shared float part[256];
void main() {
    uint n = pc.M;
    uint tid = gl_LocalInvocationID.x;
    float v = (tid < n) ? x[tid] : 0.0;
    part[tid] = v * v;
    barrier();
    for (uint s = 128; s > 0; s >>= 1) { if (tid < s) part[tid] += part[tid + s]; barrier(); }
    float rms = sqrt(part[0] / float(n) + pc.eps);
    if (tid < n) x[tid] = (v / rms) * w[tid];
}
