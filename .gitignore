/build/
/target/
**/.zig-cache/
**/*.o
**/*.so
*.pyc
__pycache__/
/rust/target

# Build artifacts that end up in tools/ or site
tools/bench_gemm
tools/bench_ternary
tools/bench_ternary_v2
tools/test_gemm_v2
tools/test_v2

# Binary model/checkpoint files that should NOT be committed (fixes #65)
# These are generated by training scripts and must be downloadable, not in git.
*.bin
*.npz
*.pt

# Cloudflare Pages build artifact
site/docs/.build/

# Cloudflare Wrangler cache
site/.wrangler/

# ck-prefill build artifacts
ck-prefill/build/

# Packaging build artifacts (object files, shared libs)
packaging/**/*.o
packaging/**/*.so
packaging/**/*.a

# Editor / OS droppings
.*.swp
*.swo
*~
.DS_Store

# Agent config (system-level, not project)
.1bit/
skills/
# Zig build artifacts (fused engine)
engine/fusion/zig-out/
engine/fusion/.zig-cache/
.zig-cache/

# Local agent config (contains local creds/tokens, per-machine worker state)
.pi/

# Self-hosted GitHub Actions runner (contains registration credentials — repo is public)
actions-runner/
.codex/

# Release packaging artifacts (published via GitHub Releases, not git)
*.deb
*.snap
*.AppImage

# NPU engine build artifacts
engine/npu/build/
npu-infer/build/
npu-infer/**/build/

# CMake build trees + compiled JS output (fixes #103 #143 #150 #151 #163 #174 #175)
/1bit/build/
/dist/
**/build/

# Node dependencies (npm ci)
node_modules/
engine/fusion/bench_fused
1bit/build/
dist/

# Zero-copy NPU↔GPU fusion substrate — built binaries (source in engine/fusion/zero_copy/)
engine/fusion/zero_copy/*.o
engine/fusion/zero_copy/*.a
engine/fusion/zero_copy/test_zero_copy
engine/fusion/zero_copy/test_pipeline
engine/fusion/zero_copy/probe_contexts
engine/fusion/zero_copy/probe_multi_xclbin
engine/fusion/zero_copy/xclbin_health
engine/fusion/zero_copy/test_parallel_real

# Model files (too large for git — use external download/symlink)
*.q4nx
*.h1b
*.gguf
*.safetensors
*.bin

# Binary artifacts in packaging (not source)
packaging/appimage/AppDir/usr/lib/*.a
packaging/appimage/AppDir/usr/lib/*.so*
packaging/appimage/AppDir/usr/lib/x86_64-linux-gnu/*
packaging/deb/usr/lib/1bit/*.o

# Stale benchmark result files (keep only latest)
benchmarks/RESULTS-*.md
!benchmarks/RESULTS-2026-07-15*.md

# NPU xclbin files (generated/built — not tracked)
engine/npu/xclbins/*.xclbin
engine/npu/xclbins/*.txt
engine/npu/xclbins/*.py
engine/npu/setup_all_xclbins.sh

# System libraries in packaging (not source)
packaging/appimage/AppDir/usr/lib/*.so*
packaging/appimage/AppDir/usr/lib/*.so
packaging/deb/usr/lib/1bit/*.o
