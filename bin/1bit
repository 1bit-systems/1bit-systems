#!/bin/bash
# 1bit CLI entry — lightweight bash wrapper
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -f "$PROJECT_ROOT/dist/cli.js" ]; then
  node "$PROJECT_ROOT/dist/cli.js" "$@"
elif [ -f "$PROJECT_ROOT/src/cli.ts" ]; then
  npx --yes tsx "$PROJECT_ROOT/src/cli.ts" "$@"
else
  echo "Error: 1bit CLI not built. Run 'npm run build' in $PROJECT_ROOT" >&2
  exit 1
fi
