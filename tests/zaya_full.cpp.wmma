// zaya_full.cpp — Zaya1-8B complete inference pipeline
// Full layer loop: CCA Attention → residual_scale → EDA Router → MoE → residual_scale
// With lm_head: final RMSNorm → logits = hs @ embed^T
//
// Build: cmake --build . --target zaya_full -j8
// Run:   ./build/zaya_full [--layers N] [--token T] [--lm]

#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#include <cstdio>
#include <cmath>
#include <vector>
#include <string>
#include <cstring>
#include <fstream>
#include <chrono>
#include <algorithm>

#define HIP_OK(e) do { auto _s=(e); if(_s!=hipSuccess){fprintf(stderr,"HIP Error %d at %s:%d\n",_s,__FILE__,__LINE__); abort();}} while(0)

constexpr int H=2048, NQ=8, NKV=2, HD=128, QD=NQ*HD, KD=NKV*HD, QKV=QD+KD;
constexpr int GQA=NQ/NKV, NROT=64, N_LAYERS=40, VOCAB=262272;
constexpr int N_EXP=16, N_EXP_T=17, N_FF=2048, RTR_H=256;
constexpr float RMD_EPS=1e-5f;
constexpr int BLK=256;

static std::vector<float> load_bin(const std::string& p){
    std::ifstream f(p,std::ios::binary|std::ios::ate);
    if(!f){fprintf(stderr,"Missing: %s\n",p.c_str());exit(1);}
    size_t n=f.tellg()/sizeof(float);f.seekg(0);
    std::vector<float> d(n);f.read((char*)d.data(),n*sizeof(float));return d;
}
static std::string L(int i){return std::to_string(i);}
#define W(N) load_bin("/tmp/zaya_weights/"+std::string(N))

static void upf16(const std::vector<float>& s,__half*d,int n,hipStream_t h=0){
    std::vector<__half>b(n);for(int i=0;i<n;i++)b[i]=__float2half(s[i]);
    HIP_OK(hipMemcpyAsync(d,b.data(),n*2,hipMemcpyHostToDevice,h));
}
static void upf32(const std::vector<float>& s,float*d,int n,hipStream_t h=0){
    HIP_OK(hipMemcpyAsync(d,s.data(),n*4,hipMemcpyHostToDevice,h));
}
static float cosim(const float* a,const float* b,int n){
    float d=0,na=0,nb=0;
    for(int i=0;i<n;i++){d+=a[i]*b[i];na+=a[i]*a[i];nb+=b[i]*b[i];}
    return d/(sqrtf(na)*sqrtf(nb)+1e-12f);
}

// ──── Kernels ────
__global__ void rmsnorm_k(__half* x, const __half* w, int n) {
    __shared__ float red[32]; int tx=threadIdx.x, wid=tx/32, l=tx%32;
    float ss=0; for(int i=tx;i<n;i+=blockDim.x) ss+=(float)x[i]*(float)x[i];
    for(int o=16;o>0;o>>=1) ss+=__shfl_xor(ss,o);
    if(l==0) red[wid]=ss; __syncthreads();
    if(wid==0){ss=(l<(256/32))?red[l]:0; for(int o=16;o>0;o>>=1) ss+=__shfl_xor(ss,o);if(l==0) red[0]=ss;} __syncthreads();
    float r=1.0f/sqrtf(red[0]/n+RMD_EPS);
    for(int i=tx;i<n;i+=blockDim.x) x[i]=__float2half((float)x[i]*r*(float)w[i]);
}
__global__ void copy_k(__half* dst, const __half* src, int n) {
    int i=blockIdx.x*blockDim.x+threadIdx.x; if(i>=n) return; dst[i]=src[i];
}
__global__ void residual_scale_k(__half* out, const __half* res,
    const float* hs_s, const float* hs_b, const float* res_s, const float* res_b, int n)
{
    int i=blockIdx.x*blockDim.x+threadIdx.x; if(i>=n) return;
    float o=(float)out[i]*hs_s[i]+hs_b[i];
    float r=(float)res[i]*res_s[i]+res_b[i];
    out[i]=__float2half(o+r);
}

// -- CCA Attention (from kernels/zaya_cca_attn.hip) --
__global__ void cca_attn_kernel(
    const __half*hs,const __half*phs,const __half*csi,int pos,
    const __half*wq,const __half*wk,const __half*wv1,const __half*wv2,const __half*wo,
    const float*cdw,const float*cdb,const float*cgw,const float*cgb,
    const float*ks,const __half*nw,
    __half*ao,__half*ncs,__half*nph);

// -- EDA Router (from kernels/zaya_gpu_router.hip) --
__global__ void eda_router_gpu_kernel(
    const __half*hs, const float*prev_rs, int has_eda, float eda_scale,
    const float*gdw, const float*gdb,
    const float*rfn, const float*rf1, const float*rf1b,
    const float*rf2, const float*rf2b,
    const float*rout, const float*bb,
    float*next_rs, int*expert_idx, float*expert_wt);

// -- WMMA MoE kernels (from kernels/zaya_moe_tiled_gemv.hip) --
__global__ void moe_gate_up_wmma(__half* out, const __half* in, const __half* wt, int M, int K);
__global__ void moe_down_wmma(__half* out, const __half* in, const __half* wt, int M, int K);
__global__ void silu_fused_kernel(__half* buf, int N);

// ──── Main ────
int main(int argc, char** argv) {
    int max_layers = N_LAYERS, token_id = 100;
    bool do_lm = false;
    for(int i=1;i<argc;i++){
        if(!strcmp(argv[i],"--layers") && i+1<argc) max_layers=atoi(argv[++i]);
        if(!strcmp(argv[i],"--token") && i+1<argc) token_id=atoi(argv[++i]);
        if(!strcmp(argv[i],"--lm")) do_lm=true;
    }
    max_layers = std::min(max_layers, N_LAYERS);
    printf("=== Zaya1-8B Full Pipeline ===\n");
    printf("Layers: %d, Token: %d%s\n", max_layers, token_id, do_lm?", lm_head":"");

    // ── Load embeddings + final norm ──
    auto embed = W("model_embed_tokens_weight.bin");
    auto fnorm = W("model_norm_weight.bin");
    auto iscale = W("model_input_hidden_states_scale.bin");
    auto ibias  = W("model_input_hidden_states_bias.bin");
    bool has_input_scale = (iscale.size()==H && ibias.size()==H);
    printf("Embed: %.0fM, FinalNorm: %zu, InputScale: %s\n",
           embed.size()/1e6, fnorm.size(), has_input_scale?"yes":"no");

    // ── Device memory ──
    __half *d_hs, *d_ao, *d_tmp, *d_phs, *d_csi, *d_moe;
    float *d_fbuf, *d_rs, *d_prev_rs;
    int *d_expert_idx; float *d_expert_wt;
    HIP_OK(hipMalloc(&d_hs, H*2));
    HIP_OK(hipMalloc(&d_ao, H*2));
    HIP_OK(hipMalloc(&d_tmp, 2*N_FF*2)); // [2*N_FF] fp16 for gate_up WMMA
    HIP_OK(hipMalloc(&d_phs, H*2));
    HIP_OK(hipMalloc(&d_csi, QKV*2*2));
    HIP_OK(hipMalloc(&d_moe, H*2));
    HIP_OK(hipMalloc(&d_fbuf, std::max(4096,H*2)*4));
    HIP_OK(hipMalloc(&d_rs, RTR_H*4));
    HIP_OK(hipMalloc(&d_prev_rs, RTR_H*4));
    HIP_OK(hipMalloc(&d_expert_idx, 4));
    HIP_OK(hipMalloc(&d_expert_wt, 4));

    hipStream_t st; HIP_OK(hipStreamCreate(&st));

    // Embed token with HF scale/bias: hs = (embed + bias) * scale
    std::vector<__half> h_tok(H);
    for(int i=0;i<H;i++){
        float raw = embed[token_id*H+i];
        if(has_input_scale) h_tok[i]=__float2half((raw+ibias[i])*iscale[i]);
        else h_tok[i]=__float2half(raw);
    }
    HIP_OK(hipMemcpyAsync(d_hs, h_tok.data(), H*2, hipMemcpyHostToDevice, st));
    HIP_OK(hipMemsetAsync(d_phs, 0, H*2, st));
    HIP_OK(hipMemsetAsync(d_csi, 0, QKV*2*2, st));
    HIP_OK(hipMemsetAsync(d_prev_rs, 0, RTR_H*4, st));
    HIP_OK(hipStreamSynchronize(st));
    printf("Embedded token %d\n", token_id);

    // ── Layer weights ──
    struct LGPU {
        // CCA attention
        __half *nw,*wq,*wk,*wv1,*wv2,*wo,*pan;
        float *cdw,*cdb,*cgw,*cgb,*ks;
        float *pahss,*pahsb,*parss,*parsb;
        // EDA Router
        float *gdw,*gdb,*rfn,*rf1,*rf1b,*rf2,*rf2b,*rout,*bb;
        __half *gu,*dn;
        // Post-MLP residual scale
        float *pmhss,*pmhsb,*pmrss,*pmrsb;
    };
    std::vector<LGPU> lg(max_layers);

    printf("Loading layers...\n");
    for(int il=0; il<max_layers; il++){
        auto& l=lg[il];
        auto A=[&](auto&p,int n){HIP_OK(hipMalloc(&p,n*2));};
        auto B=[&](auto&p,int n){HIP_OK(hipMalloc(&p,n*4));};

        // -- CCA attention --
        A(l.nw,H);  upf16(W("model_layers_"+L(il)+"_input_layernorm_weight.bin"),l.nw,H,st);
        A(l.wq,QD*H); upf16(W("model_layers_"+L(il)+"_self_attn_qkv_proj_q_proj_weight.bin"),l.wq,QD*H,st);
        A(l.wk,KD*H); upf16(W("model_layers_"+L(il)+"_self_attn_qkv_proj_k_proj_weight.bin"),l.wk,KD*H,st);
        A(l.wv1,(KD/2)*H); upf16(W("model_layers_"+L(il)+"_self_attn_qkv_proj_v_proj_current_weight.bin"),l.wv1,(KD/2)*H,st);
        A(l.wv2,(KD/2)*H); upf16(W("model_layers_"+L(il)+"_self_attn_qkv_proj_v_proj_delayed_weight.bin"),l.wv2,(KD/2)*H,st);
        A(l.wo,H*QD); upf16(W("model_layers_"+L(il)+"_self_attn_o_proj_weight.bin"),l.wo,H*QD,st);
        A(l.pan,H); upf16(W("model_layers_"+L(il)+"_post_attention_layernorm_weight.bin"),l.pan,H,st);
        B(l.cdw,QKV*2); upf32(W("model_layers_"+L(il)+"_self_attn_qkv_proj_conv_qk_depthwise_weight.bin"),l.cdw,QKV*2,st);
        B(l.cdb,QKV);   upf32(W("model_layers_"+L(il)+"_self_attn_qkv_proj_conv_qk_depthwise_bias.bin"),l.cdb,QKV,st);
        B(l.cgw,QKV*128*2); upf32(W("model_layers_"+L(il)+"_self_attn_qkv_proj_conv_qk_grouped_weight.bin"),l.cgw,QKV*128*2,st);
        B(l.cgb,QKV);   upf32(W("model_layers_"+L(il)+"_self_attn_qkv_proj_conv_qk_grouped_bias.bin"),l.cgb,QKV,st);
        B(l.ks,NKV);    upf32(W("model_layers_"+L(il)+"_self_attn_qk_norm_temp.bin"),l.ks,NKV,st);
        B(l.pahss,H); upf32(W("model_layers_"+L(il)+"_post_attention_residual_scale_hidden_states_scale.bin"),l.pahss,H,st);
        B(l.pahsb,H); upf32(W("model_layers_"+L(il)+"_post_attention_residual_scale_hidden_states_bias.bin"),l.pahsb,H,st);
        B(l.parss,H); upf32(W("model_layers_"+L(il)+"_post_attention_residual_scale_residual_scale.bin"),l.parss,H,st);
        B(l.parsb,H); upf32(W("model_layers_"+L(il)+"_post_attention_residual_scale_residual_bias.bin"),l.parsb,H,st);

        // -- EDA Router (float32) --
        B(l.gdw,RTR_H*H); upf32(W("model_layers_"+L(il)+"_mlp_gate_down_proj_weight.bin"),l.gdw,RTR_H*H,st);
        B(l.gdb,RTR_H);   upf32(W("model_layers_"+L(il)+"_mlp_gate_down_proj_bias.bin"),l.gdb,RTR_H,st);
        B(l.rfn,RTR_H);   upf32(W("model_layers_"+L(il)+"_mlp_gate_router_mlp_norm_weight.bin"),l.rfn,RTR_H,st);
        B(l.rf1,RTR_H*RTR_H); upf32(W("model_layers_"+L(il)+"_mlp_gate_router_mlp_fc1_weight.bin"),l.rf1,RTR_H*RTR_H,st);
        B(l.rf1b,RTR_H);  upf32(W("model_layers_"+L(il)+"_mlp_gate_router_mlp_fc1_bias.bin"),l.rf1b,RTR_H,st);
        B(l.rf2,RTR_H*RTR_H); upf32(W("model_layers_"+L(il)+"_mlp_gate_router_mlp_fc2_weight.bin"),l.rf2,RTR_H*RTR_H,st);
        B(l.rf2b,RTR_H);  upf32(W("model_layers_"+L(il)+"_mlp_gate_router_mlp_fc2_bias.bin"),l.rf2b,RTR_H,st);
        B(l.rout,N_EXP_T*RTR_H); upf32(W("model_layers_"+L(il)+"_mlp_gate_router_mlp_out_proj_weight.bin"),l.rout,N_EXP_T*RTR_H,st);
        B(l.bb,N_EXP_T);  upf32(W("model_layers_"+L(il)+"_mlp_gate_balancing_biases.bin"),l.bb,N_EXP_T,st);

        // -- MoE experts (fp16) --
        A(l.gu,N_EXP*2*N_FF*H); upf16(W("model_layers_"+L(il)+"_mlp_experts_gate_up_proj.bin"),l.gu,N_EXP*2*N_FF*H,st);
        A(l.dn,N_EXP*H*N_FF);   upf16(W("model_layers_"+L(il)+"_mlp_experts_down_proj.bin"),l.dn,N_EXP*H*N_FF,st);

        // -- Post-MLP residual scale --
        B(l.pmhss,H); upf32(W("model_layers_"+L(il)+"_post_mlp_residual_scale_hidden_states_scale.bin"),l.pmhss,H,st);
        B(l.pmhsb,H); upf32(W("model_layers_"+L(il)+"_post_mlp_residual_scale_hidden_states_bias.bin"),l.pmhsb,H,st);
        B(l.pmrss,H); upf32(W("model_layers_"+L(il)+"_post_mlp_residual_scale_residual_scale.bin"),l.pmrss,H,st);
        B(l.pmrsb,H); upf32(W("model_layers_"+L(il)+"_post_mlp_residual_scale_residual_bias.bin"),l.pmrsb,H,st);
    }
    HIP_OK(hipStreamSynchronize(st));
    printf("Loaded %d layers.\n", max_layers);

    // ──── Forward pass ────
    int g1 = (H+BLK-1)/BLK;
    auto t0 = std::chrono::high_resolution_clock::now();

    for(int il=0; il<max_layers; il++){
        auto& l = lg[il];

        // ── A) CCA Attention (RMSNorm + QKV + conv_qk + RoPE + GQA + o_proj) ──
        cca_attn_kernel<<<1,128,0,st>>>(
            d_hs, d_phs, d_csi, il,
            l.wq, l.wk, l.wv1, l.wv2, l.wo,
            l.cdw, l.cdb, l.cgw, l.cgb, l.ks, l.nw,
            d_ao, d_csi, d_phs);

        // Save raw attn out for verification (layer 0)
        if(il==0) copy_k<<<g1,BLK,0,st>>>(d_tmp, d_ao, H);

        // ── B) Post-attention residual scale: ao = ao*hs_scale+hs_bias + hs*res_scale+res_bias ──
        residual_scale_k<<<g1,BLK,0,st>>>(d_ao, d_hs, l.pahss, l.pahsb, l.parss, l.parsb, H);

        // ── C) Post-attention RMSNorm (on d_hs, for consistency with original) ──
        rmsnorm_k<<<1,BLK,0,st>>>(d_hs, l.pan, H);

        // ── D) EDA Router → expert_idx (4 bytes D2H) ──
        // Router input = d_ao (pre-LN, same as original eda_router_moe_kernel)
        eda_router_gpu_kernel<<<1,256,0,st>>>(
            d_ao, d_prev_rs, 1, 1.0f,
            l.gdw, l.gdb, l.rfn, l.rf1, l.rf1b,
            l.rf2, l.rf2b, l.rout, l.bb,
            d_rs, d_expert_idx, d_expert_wt);
        std::swap(d_rs, d_prev_rs);

        // ── E) Read expert + WMMA MoE expert FFN ──
        // hipMemcpy syncs stream: waits for router kernel to complete
        int expert;
        HIP_OK(hipMemcpy(&expert, d_expert_idx, sizeof(int), hipMemcpyDeviceToHost));
        if(expert < N_EXP){
            int gw=(2*N_FF+15)/16;
            // MoE input = d_ao (pre-LN, same as original fused kernel)
            moe_gate_up_wmma<<<gw,16,0,st>>>(d_tmp, d_ao,
                l.gu+(size_t)expert*2*N_FF*H, 2*N_FF, H);
            silu_fused_kernel<<<(N_FF+BLK-1)/BLK,BLK,0,st>>>(d_tmp, N_FF);
            gw=(H+15)/16;
            moe_down_wmma<<<gw,16,0,st>>>(d_moe, d_tmp,
                l.dn+(size_t)expert*H*N_FF, H, N_FF);
        } else {
            copy_k<<<g1,BLK,0,st>>>(d_moe, d_hs, H);
        }

        // ── F) Post-MLP residual scale: moe = moe*hs_scale+hs_bias + d_ao*res_scale+res_bias ──
        residual_scale_k<<<g1,BLK,0,st>>>(d_moe, d_ao, l.pmhss, l.pmhsb, l.pmrss, l.pmrsb, H);

        // ── F) Copy result back to d_hs for next layer ──
        copy_k<<<g1,BLK,0,st>>>(d_hs, d_moe, H);

        // ── G) Swap router state buffers ──
        // next_rs becomes prev_rs for next layer (EDA carry)
        // We'll ping-pong by swapping pointers
        std::swap(d_rs, d_prev_rs);
    }

    HIP_OK(hipStreamSynchronize(st));
    float ms = std::chrono::duration<float,std::milli>(
        std::chrono::high_resolution_clock::now()-t0).count();

    // ──── lm_head ────
    int predicted_token = -1;
    if(do_lm){
        // Final RMSNorm
        __half *d_fnorm;
        HIP_OK(hipMalloc(&d_fnorm, H*2));
        upf16(fnorm, d_fnorm, H, st);
        rmsnorm_k<<<1,BLK,0,st>>>(d_hs, d_fnorm, H);

        // logits[idx] = sum_j hs[j] * embed[idx][j]
        // For efficiency, only compute top-N or do full 262k.
        // Here we compute for the first 1000 tokens to find the predicted one.
        constexpr int N_LOGIT = 1000;
        std::vector<float> logits(N_LOGIT);
        std::vector<__half> h_hs(H);
        HIP_OK(hipMemcpy(h_hs.data(), d_hs, H*2, hipMemcpyDeviceToHost));
        for(int i=0;i<N_LOGIT;i++){
            float s=0;
            for(int j=0;j<H;j++) s+=__half2float(h_hs[j])*embed[i*H+j];
            logits[i]=s;
        }
        predicted_token = (int)(std::max_element(logits.begin(),logits.end())-logits.begin());
        printf("lm_head[0:%d]: token %d (score=%.2f)\n", N_LOGIT, predicted_token, logits[predicted_token]);
        HIP_OK(hipFree(d_fnorm));
    }

    // ──── Read outputs + verify ────
    std::vector<__half> raw_ao(H), final_hs(H);
    HIP_OK(hipMemcpy(raw_ao.data(), d_tmp, H*2, hipMemcpyDeviceToHost));
    HIP_OK(hipMemcpy(final_hs.data(), d_hs, H*2, hipMemcpyDeviceToHost));

    // Gold reference for layer 0 raw attention output
    std::vector<float> gold(H);
    FILE* py=popen("python3 -c \"import numpy as np; d=np.load('/tmp/cca_ref_current.npz'); d['scaled'].tofile('/tmp/zaya_gold.bin')\"","r");
    if(py)pclose(py);
    std::ifstream gf("/tmp/zaya_gold.bin",std::ios::binary);
    if(gf){gf.read((char*)gold.data(),H*sizeof(float));}

    std::vector<float> gpu_attn(H);
    for(int i=0;i<H;i++) gpu_attn[i]=__half2float(raw_ao[i]);
    float cs = cosim(gpu_attn.data(), gold.data(), H);

    printf("\n═══ Results ═══\n");
    printf("%d layers: %.2f ms total (%.3f ms/layer)\n", max_layers, ms, ms/max_layers);
    printf("Layer 0 attn vs gold: cos_sim=%.6f %s\n", cs, cs>0.99f?"PASS":"FAIL");
    printf("Attn[0:4]: %.4f %.4f %.4f %.4f\n",gpu_attn[0],gpu_attn[1],gpu_attn[2],gpu_attn[3]);
    printf("Gold[0:4]: %.4f %.4f %.4f %.4f\n",gold[0],gold[1],gold[2],gold[3]);
    printf("Final hs[0:4]: %.4f %.4f %.4f %.4f\n",
           __half2float(final_hs[0]),__half2float(final_hs[1]),
           __half2float(final_hs[2]),__half2float(final_hs[3]));
    if(predicted_token>=0){
        printf("Predicted token: %d", predicted_token);
        // Try to decode common tokens (Qwen-style BPE tokenizer)
        if(predicted_token < 200) printf(" (likely control token)");
        printf("\n");
    }

    // ── Cleanup ──
    hipFree(d_hs); hipFree(d_ao); hipFree(d_tmp); hipFree(d_phs); hipFree(d_csi);
    hipFree(d_moe); hipFree(d_fbuf); hipFree(d_rs); hipFree(d_prev_rs);
    hipFree(d_expert_idx); hipFree(d_expert_wt);
    for(auto& l : lg){
        hipFree(l.nw); hipFree(l.wq); hipFree(l.wk); hipFree(l.wv1); hipFree(l.wv2);
        hipFree(l.wo); hipFree(l.pan); hipFree(l.cdw); hipFree(l.cdb);
        hipFree(l.cgw); hipFree(l.cgb); hipFree(l.ks);
        hipFree(l.pahss); hipFree(l.pahsb); hipFree(l.parss); hipFree(l.parsb);
        hipFree(l.gdw); hipFree(l.gdb); hipFree(l.rfn); hipFree(l.rf1); hipFree(l.rf1b);
        hipFree(l.rf2); hipFree(l.rf2b); hipFree(l.rout); hipFree(l.bb);
        hipFree(l.gu); hipFree(l.dn);
        hipFree(l.pmhss); hipFree(l.pmhsb); hipFree(l.pmrss); hipFree(l.pmrsb);
    }
    hipStreamDestroy(st);
    printf("Done.\n");
    return cs>0.99f?0:1;
}
