[Unit]
Description=1bit NPU Daemon (C++ engine, MIT, 97 tok/s)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /home/bcloud/daemon/npu-gpu-cpud.py --port 9090
Restart=always
RestartSec=5
LimitMEMLOCK=infinity
# NPU C++ engine path (built from engine/npu/Makefile)
Environment=NPU_ENGINE_BIN=/home/bcloud/engine/npu/build/npu_engine_server
Environment=NPU_MODEL_PATH=/home/bcloud/.config/flm/models/Qwen3-0.6B-NPU2/model.q4nx
Environment=NPU_TOKENIZER_PATH=/home/bcloud/.config/flm/models/Qwen3-0.6B-NPU2/tokenizer.json
# Stripe secret key for merch store checkout:
#   sudo sed -i 's/^#Environment=STRIPE/Environment=STRIPE/' /etc/systemd/system/npu-daemon.service
#   sudo systemctl daemon-reload && sudo systemctl restart npu-daemon
#Environment=STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
